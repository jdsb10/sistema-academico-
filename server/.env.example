# Copiar como .env para desarrollo local. NO versionar el .env con valores reales.

# Base de datos embebida (solo local). En produccion usar DATABASE_URL administrado.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistema_academico?schema=public"
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=sistema_academico

# Servidor
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Seguridad: generar secretos nuevos antes de desplegar
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-de-al-menos-16-caracteres"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-de-al-menos-16-caracteres"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# CORS (en produccion, el dominio final)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Correo: console imprime los mensajes en el log; smtp envia de verdad
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="sistema-academico@universidad.edu.co"

# Respaldos HU-24 (en produccion apuntar a un volumen persistente)
BACKUP_DIR="./backups"
