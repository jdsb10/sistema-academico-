{
  "name": "sistema-academico",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Academico Universitario - Proyecto Final Ingenieria de Software II",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "npm run db:up --workspace server",
    "db:down": "npm run db:down --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "test:e2e": "npm run test:e2e",
    "start": "npm run start --workspace server",
    "start:prod": "prisma migrate deploy --schema server/prisma/schema.prisma && node server/dist/main.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@scarf/scarf": false
  }
}
